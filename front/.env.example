# true  -> réponses mockées en local (src/api/mock.js), aucun back nécessaire
# false -> appels réels vers /api/v1/classement (proxifié vers VITE_BACK_URL par Vite)
VITE_USE_MOCK=true

# URL du back (utilisée uniquement par le proxy de dev Vite)
VITE_BACK_URL=http://localhost:3000

# Jeton Bearer envoyé dans l'en-tête Authorization (contrat : securitySchemes.playerToken)
VITE_API_TOKEN=dev-token
